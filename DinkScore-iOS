      - name: Generate Xcode Project (iOS + watchOS Targets)
        run: |
          cd dinkscore_apple
          xcodegen generate
          zip -r ../DinkScore-v3.7-XcodeProject.zip DinkScore.xcodeproj Sources Resources project.yml

      - name: Build iPhone & iPad App (.ipa)
        run: |
          cd dinkscore_apple
          xcodebuild -project DinkScore.xcodeproj \
            -scheme DinkScore \
            -configuration Release \
            -sdk iphoneos \
            -derivedDataPath build_ios \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_IDENTITY="" \
            AD_HOC_CODE_SIGNING_ALLOWED=YES \
            build
          mkdir -p Payload
          cp -R build_ios/Build/Products/Release-iphoneos/DinkScore.app Payload/
          zip -r ../DinkScore-v3.7-iOS.ipa Payload

      - name: Verify Apple Watch App Build (watchOS)
        run: |
          cd dinkscore_apple
          xcodebuild -project DinkScore.xcodeproj \
            -scheme DinkScoreWatch \
            -configuration Release \
            -sdk watchos \
            -derivedDataPath build_watch \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_IDENTITY="" \
            AD_HOC_CODE_SIGNING_ALLOWED=YES \
            build

      - name: Upload DinkScore v3.7 iOS IPA & Xcode Project Bundle
        uses: actions/upload-artifact@v4
        with:
          name: DinkScore-v3.7-Apple-Bundle
          path: |
            DinkScore-v3.7-iOS.ipa
            DinkScore-v3.7-XcodeProject.zip
